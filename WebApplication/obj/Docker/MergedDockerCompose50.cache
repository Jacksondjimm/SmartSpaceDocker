name: dockercompose342896922453503103
services:
  razorpagesapp:
    build:
      context: G:\Works\Docker\26_03_29_Smart_PGDB_docker_keenetic_https_migration_debug\WebApplication
      dockerfile: WebApplication/Dockerfile
    container_name: razorpagesapp
    depends_on:
      razorpagesapp.database:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "5000"
      ConnectionStrings__Database: Host=razorpagesapp.database;Port=5432;Database=SmartSpaceDb;Username=postgres;Password=combust0201;Include Error Detail=true
      DOTNET_SYSTEM_GLOBALIZATION_INVARIANT: "false"
      TZ: Europe/Moscow
    image: razorpagesapp
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5000
        published: "5000"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\Jackson\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Jackson\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
  razorpagesapp.database:
    container_name: razorpagesapp.database
    environment:
      POSTGRES_DB: SmartSpaceDb
      POSTGRES_PASSWORD: combust0201
      POSTGRES_USER: postgres
    image: postgres:17
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    volumes:
      - type: bind
        source: G:\Works\Docker\26_03_29_Smart_PGDB_docker_keenetic_https_migration_debug\WebApplication\.containers\razorpagesapp-db
        target: /var/lib/postgresql/data
        bind:
          create_host_path: true
networks:
  default:
    name: dockercompose342896922453503103_default